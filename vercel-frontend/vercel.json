{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api",
      "destination": "https://REPLACE-WITH-YOUR-RAILWAY-BACKEND.up.railway.app/api"
    },
    {
      "source": "/api/:path*",
      "destination": "https://REPLACE-WITH-YOUR-RAILWAY-BACKEND.up.railway.app/api/:path*"
    }
  ],
  "outputDirectory": "public"
}
